ARG LITELLM_IMAGE
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.11.7@sha256:240fb85ab0f263ef12f492d8476aa3a2e4e1e333f7d67fbdd923d00a506a516a

FROM $UV_IMAGE AS uvbin

FROM $LITELLM_IMAGE

RUN --mount=from=uvbin,source=/uv,target=/usr/local/bin/uv \
    --mount=type=bind,source=pyproject.toml,target=/lock/pyproject.toml \
    --mount=type=bind,source=uv.lock,target=/lock/uv.lock \
    --mount=type=bind,source=litellm-proxy-extras/pyproject.toml,target=/lock/litellm-proxy-extras/pyproject.toml \
    uv export --project /lock --frozen --no-emit-workspace --no-default-groups --extra mlflow --quiet --output-file /tmp/locked.txt && \
    uv pip install --python /app/.venv/bin/python --no-cache --require-hashes --constraint /tmp/locked.txt \
        "$(grep -o '^mlflow-skinny==[^ ]*' /tmp/locked.txt)" && \
    rm /tmp/locked.txt && \
    python -c "import mlflow"
